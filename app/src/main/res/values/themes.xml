<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Pure-Compose app, so this only has to cover the window before the first frame.
      A dark windowBackground avoids a white flash on launch.
    -->
    <style name="Theme.Speedometer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
